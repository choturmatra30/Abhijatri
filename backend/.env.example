# Copy to .env (never commit .env). Production values live only in Render's dashboard.
APP_ENV=development                       # development | test | production
DATABASE_URL=postgresql+psycopg://abhijatri:abhijatri_dev@localhost:5432/abhijatri
# Supabase (Render/shared envs): SESSION pooler URI, port 5432, with sslmode=require
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# MIGRATION_DATABASE_URL=                 # optional; falls back to DATABASE_URL
TEST_DATABASE_URL=postgresql+psycopg://abhijatri:abhijatri_dev@localhost:5432/abhijatri_test
# >=32 chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
RECEIPT_PEPPER=replace-with-at-least-32-random-characters
# RECEIPT_KEYS={"v1":"<secret of at least 32 characters>"}  # versioned HMAC keyring; defaults to {"v1": RECEIPT_PEPPER}
# RECEIPT_KEY_CURRENT=v1                  # key used for new digests; keep older keys until no stored digest uses them
RECEIPT_SESSION_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:5173   # comma-separated explicit origins, never *
LOG_LEVEL=INFO
TZ=UTC                                    # process timezone
APP_TIMEZONE=UTC                          # storage/compute zone; must be UTC
DEFAULT_DISPLAY_TIMEZONE=Asia/Dhaka       # IANA zone for the Dhaka-calendar rules (visit_month)
# DOCS_ENABLED=true                       # defaults: on in development/test, off in production
ADVISORY_STALE_AFTER_DAYS=30              # advisory shown as STALE when last verified longer ago than this
PUBLIC_CACHE_MAX_AGE_SECONDS=60           # Cache-Control max-age on public destination routes
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=5                         # seconds to wait for a pooled connection
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
REQUEST_TIMEOUT_SECONDS=15
MAX_REQUEST_BODY_BYTES=65536
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GUEST_SUBMIT=5/minute
RATE_LIMIT_RECEIPT=10/minute
# ALLOW_TEST_STAFF_HEADER=true            # local development ONLY: X-Test-Staff-Id acts as a staff login
# CLIENT_ADDRESS_HEADER=X-Forwarded-For   # production: the ONE provider-appended header, proven by the forged-header test (PF 14.2)
# CLIENT_ADDRESS_POSITION=-1              # which comma-separated entry to trust; -1 = right-most (appended by the edge)
# TURNSTILE_ENABLED=true                  # required in production
# TURNSTILE_SECRET=                       # Cloudflare Turnstile secret key
# TURNSTILE_HOSTNAME=app.example.com      # hostname Cloudflare must report for a valid token
GUEST_SUBMIT_PER_SCOPE_PER_DAY=3
GUEST_SUBMIT_PER_NETWORK_PER_HOUR=30
GUEST_SUBMIT_PER_NETWORK_PER_DAY=100
RECEIPT_OPS_PER_RECEIPT_PER_HOUR=20
RECEIPT_OPS_PER_NETWORK_PER_HOUR=100
RECEIPT_FAILURES_SHORT_LIMIT=5            # failed receipt lookups per 15 minutes before a progressive block
RECEIPT_FAILURES_LONG_LIMIT=20            # failed receipt lookups per 24 hours
GUEST_PENDING_PER_DESTINATION=50
GUEST_PENDING_TOTAL=500
GUEST_WRITES_PAUSED=false                 # emergency switch: pauses new Guest writes, reads continue
