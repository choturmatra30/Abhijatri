
# -----------------------------------------------------------------------------
# Core Backend API Configurations
# -----------------------------------------------------------------------------
# For Local Development:
VITE_API_BASE_URL=http://localhost:8000

# For Railway / Cloud Deployment (uncomment and replace in hosting dashboard):
# VITE_API_BASE_URL=https://your-backend-production-url.up.railway.app

# Extra deployed API hostnames the System Status page may test (comma-separated, no scheme)
# VITE_ALLOWED_BACKEND_HOSTS=abhijatri-backend.up.railway.app

# Send review category ratings to the API. Leave false until the review service accepts
# `category_ratings` (R07); the API rejects unknown fields.
VITE_REVIEW_CATEGORY_RATINGS=false

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# -----------------------------------------------------------------------------
# Time Zone & Regional Formatting Settings
# -----------------------------------------------------------------------------
# Target display timezone for rendering UI dates/times to users (GMT+6)
VITE_DEFAULT_TIMEZONE=Asia/Dhaka
# Target locale for date, time, and currency formatting
VITE_DEFAULT_LOCALE=en-BD

# -----------------------------------------------------------------------------
# Session & UI Timeout Configurations
# -----------------------------------------------------------------------------
# Synchronized with backend RECEIPT_SESSION_MINUTES
VITE_SESSION_TIMEOUT_MINUTES=15

# -----------------------------------------------------------------------------
# Optional Third-Party Services
# -----------------------------------------------------------------------------
# VITE_SENTRY_DSN=
# VITE_MAPBOX_ACCESS_TOKEN=
